    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json.text || '';\nconst jsonMatch = rawText.match(/\\{[\\s\\S]*\\}/);\n\nif (jsonMatch) {\n  try {\n    const parsedData = JSON.parse(jsonMatch[0]);\n    return { json: parsedData };\n  } catch (e) {\n    return { json: { status: \"Cold\", rawResponse: rawText } };\n  }\n} else {\n  return { \n    json: { \n      status: \"Cold\", \n      notes: rawText,\n      budget: \"غير محدد\",\n      location: \"غير محدد\"\n    } \n  };\n}"
      },
      "id": "e4fa4bab-cddf-4de1-a9e8-954bc651af25",
